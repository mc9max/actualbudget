# Actual Budget on Railway — environment reference
#
# Copy to `.env` for local reference only. The one-click template needs ZERO
# variables: everything below is pre-set or injected automatically. Set a
# server password after first boot in the web UI (Settings).

# Data directory (baked default: /data — the persistent volume mount).
# All state lives here: account.sqlite (login/sessions) and budget files.
ACTUAL_DATA_DIR=/data

# Injected automatically by Railway — the server binds 0.0.0.0:$PORT
# (upstream honors process.env.PORT natively; ACTUAL_PORT also works).
PORT=8080

# --- Optional upstream tunables (add as service variables if needed) ---

# Bind hostname (default :: — all interfaces; fine behind Railway's proxy).
# ACTUAL_HOSTNAME=::

# Auth method: password (default), header, or openid.
# ACTUAL_LOGIN_METHOD=password

# Comma-separated list of trusted reverse proxies (needed for correct
# client IPs / secure cookies behind extra proxies).
# ACTUAL_TRUSTED_PROXIES=

# Serve HTTPS directly (Railway already terminates TLS; not needed).
# ACTUAL_HTTPS_KEY=
# ACTUAL_HTTPS_CERT=

# Upload limits in MB (sync file, encrypted sync file, general file).
# ACTUAL_UPLOAD_FILE_SIZE_LIMIT_MB=20
# ACTUAL_UPLOAD_SYNC_ENCRYPTED_FILE_SIZE_LIMIT_MB=50
# ACTUAL_UPLOAD_GENERAL_FILE_SIZE_LIMIT_MB=50

# Session token lifetime (default 30d-ish; see upstream docs).
# ACTUAL_TOKEN_EXPIRATION=2592000

# OpenID Connect (see upstream docs for ACTUAL_OPENID_DISCOVERY_URL,
# ACTUAL_OPENID_CLIENT_ID, ACTUAL_OPENID_CLIENT_SECRET, ...).
# ACTUAL_ENFORCE_OPENID=false

# Bank sync via SimpleFIN / GoCardless is configured in the web UI per
# budget, not via env vars.
